; Ninja (Mastertronic / Icon Design, 1986), 48K: SkoolKit control file.
; Generated by tools/gen_ctl.py from a traced run (tools/run_trace.py --hist,
; build/trace/hist). 'c' = executed in the trace; 'b' between them = data or
; code the trace did not reach. Names with (?) are unverified guesses.
; Image: build/zx/ram4000.bin = RAM $4000-$FF7F.

@ $4000 org
@ $EBE9 start
b $4000 Screen, attributes, system variables, free RAM
@ $69DE label=LOADER_2STAGE
c $69DE Second-stage loader copy (clear screen, LOAD via ROM $0556)
b $6A00
@ $6A25 label=LOADER_LOAD_LOOP
c $6A25 Loader: wait key, load blocks
@ $6A56 label=LOADER_PAUSE
c $6A56 HALT x25 delay
@ $6A5C label=WAIT_KEYPRESS
c $6A5C Wait for key
@ $6A64 label=LOADER_3STAGE_COPY
b $6A64 Unused copy of the loader (length $BFC0)
@ $5CEF label=POSTLOAD_NOPS
c $5CEF 64 NOPs: the loader RET lands here; falls into JP $D714 (bugfix patch lives here)
b $5D32
@ $7300 label=ROOM_STREAM_DATA
b $7300 Room streams (see ROOM_STREAMS), floor stream at $7808
@ $7808 label=FLOOR_STREAM
b $7808 Floor of every room: 200 cells from row 14 col 24
@ $8134 label=WALL_LEFT
b $8134 Left wall block, 4 x 15 tiles in 40-wide rows
@ $8158 label=WALL_RIGHT
b $8158 Right wall block, 4 x 15 tiles in 40-wide rows
@ $8AB7 label=TILE_MAP
b $8AB7 Room tile map, 1 byte per character cell; play area from $8BF7
@ $D00C label=TILE_GFX
b $D00C Room tile graphics, 8 bytes per tile
@ $D714 label=START_TRAMPOLINE
c $D714 JP GAME_START
@ $D717 label=ROW_TABLE
b $D717 Screen row address table, 2 bytes per pixel row
@ $D897 label=NEIGHBOURS
b $D897 Per room: left, right, up, down as room+1 (0 = no exit)
@ $D8EB label=ROOM_NAME_ARTICLE
b $D8EB Per room: character put into APPROACHING message
@ $D900 label=ROOM_NAMES
b $D900 21 zero-terminated room names in room order
@ $D925 label=MSG_TORII_IN_THE_SEA
b $D925 Message text
@ $D94F label=MSG_SHIJO_ENTRANCE
b $D94F Message text
@ $D968 label=MSG_AKUMAS_CHAMBER
b $D968 Message text
@ $D9CF label=MSG_BIG_GREEN_DOOR
b $D9CF Message text
@ $D9DE label=ROOM_STREAMS
b $D9DE 21 pointers to room tile streams
@ $DA0C label=FRAME_TABLE
b $DA0C Actor animation frame table (word per frame)
@ $DA70 label=MAX_ENEMIES
b $DA70 Per room: enemy slots
@ $DA85 label=ROOM_ENEMIES
b $DA85 Per room 5 bytes: $F0+type of each enemy (filled by CLEAR_ROOM_TABLES)
@ $DB44 label=MSG_REDEFINE_KEYS
b $DB44 Message text
@ $DB7A label=HUD_TEXT
b $DB7A HUD strings; score digits at $DB86
@ $DB86 label=SCORE_DIGITS
b $DB86 Score, 5 ASCII digits
@ $DBB5 label=HOLES
b $DBB5 Per room 2 bytes: X of ceiling hole, X of floor hole (0 = none)
@ $DECA label=RANDOM
c $DECA Pseudo-random byte in A; 32-bit shift register at RNG_SEED
@ $DEF1 label=RNG_SEED
b $DEF1 RANDOM state (4 bytes), seeded from R at start
@ $DEFB label=PRINT_STRING
c $DEFB Print 0-terminated string at HL (control codes handled by PRINT_CHAR)
@ $DF04 label=PRINT_CHAR
c $DF04 Print one character / control code
@ $DF47 label=PRINT_STRING_BIG
c $DF47 Print string at HL in double height (sets flag $DEF5)
@ $DF55 label=PRINT_CHAR_BIG
c $DF55 Print one character double height
@ $DF65 label=DRAW_CHAR8
c $DF65 Copy 8 bytes from DE to screen at HL (INC H per row)
@ $DF85 label=DRAW_CHAR16
c $DF85 Copy 8 bytes from DE doubled vertically (16 screen rows)
@ $DFAB label=SCREEN_ADDR
c $DFAB Screen address from character coordinates in B/C
@ $DFCA label=SET_BORDER_ATTR
c $DFCA Border = B (also BORDCR), fill attributes with C
b $DFE1
@ $DFE3 label=CLEAR_SCREEN
c $DFE3 Zero pixels $4000-$57FF with a PUSH fill (SP=$5800 down to $4000). With interrupts on (bug 1) an interrupt near the end pushes below $4000 into ROM and the game crashes
@ $E007 label=NEXT_ROW
c $E007 HL = next screen pixel row (hottest routine: sprite drawing)
@ $E01A label=ADD_HL_A
c $E01A HL += A
@ $E021 label=KEY_TABLES
b $E021 Control tables per control type: (port row, mask) triples
@ $E0E5 label=REDEFINE_KEYS
c $E0E5 Menu 5: prompt and read five keys into KEY_TABLES
@ $E16F label=PRINT_KEY_PROMPT
c $E16F Print prompt $E0B6 with key number A
@ $E178 label=READ_NEW_KEY
c $E178 Wait for a key not used yet (ROM KEY-SCAN), store port row/mask at HL
b $E1BB
c $E1C1
b $E1C5
c $E1CB
b $E1CF
c $E1D5
b $E1D9
c $E1DB
b $E1DF
c $E1E1
@ $E1EC label=CONTROL_TYPE
b $E1EC Menu choice 1..5 minus one
@ $E1ED label=HERO_INPUT
b $E1ED Input bytes: hero at $E1ED, actors 1..5 follow (AI writes them)
@ $E1F4 label=READ_CONTROLS
c $E1F4 Read keys (table at $E021 by control type $E1EC) and Kempston into HERO_INPUT
b $E216
c $E217
b $E244
@ $E276 label=WAIT_KEY
c $E276 Delay, then wait for a key via ROM KEY-SCAN ($028E)
b $E28F
c $E298
@ $E2A3 label=MENU_CHOICE
c $E2A3 Wait for menu digit 0-5, click, return 0-5 in A
@ $E2B4 label=TABLE_WORD
c $E2B4 HL = word at HL + 2*A
@ $E2C0 label=CLICK
c $E2C0 Menu click through ROM BEEPER (bug 1: BEEPER ends with EI)
b $E2D2
@ $E2D5 label=DRAW_FIELD
c $E2D5 Tile map $8BF7 -> back buffer (screen+$1B00): 320 cells (rows 10-19); full 672 cells from $8AB7 if $E2D4. Empty cells skipped. ~40% of CPU
@ $E336 label=CLEAR_ROOM_TABLES
c $E336 Place enemies in all rooms: MAX_ENEMIES slots, each but last present with p=191/256, random type 1..3 (new game and every up/down move)
@ $E37E label=TILE_ATTR
b $E37E Attribute per tile (BRIGHT added when drawn)
@ $E461 label=ACTORS
b $E461 6 actor records x 15 bytes ($E461-$E4BA)
@ $E4BA label=ROOM
b $E4BA Current room. Bug 2: it is byte 14 of actor record 5; bugfix moves it to $E4BB
@ $E4BC label=IDOL_ROOMS
b $E4BC 6 random distinct rooms 1..20 (not 11) holding idols
@ $E4C2 label=PENDING_POINTS
b $E4C2 Points still to add to the score, 2 per main loop pass
@ $E4CC label=IDOLS_HELD
b $E4CC Idols collected; 7 in room 4 = WINNER
@ $E4D9 label=HOLE_CEIL
b $E4D9 X of the ceiling hole in this room (0 = none); HOLE_FLOOR follows
@ $E4DF label=TILE_ADDR
c $E4DF HL = TILE_GFX + 8 * tile ($E4CB)
@ $E4ED label=NEXT_ROW_SHADOW
c $E4ED Advance DE = HL+$1B00 shadow pointer one row with NEXT_ROW
@ $E4FC label=MOVE_ENEMIES
c $E4FC For actors 5..1: movement/state from per-actor input bytes (?)
@ $E583 label=ANIMATE_ACTORS
c $E583 For actors 5..1: animation via table $E892 (?)
@ $E741 label=ACTOR_INPUT
c $E741 A = input byte of current actor ($E8A2) from $E1ED table
@ $E74B label=ACTOR_FIELD8
c $E74B Test field +8 of actor B
@ $E757 label=GET_E8A4
c $E757 A = ($E8A4)
@ $E7D8 label=SET_ACTOR_INPUT
c $E7D8 Store A as current actor input ($E1ED+n) and $E899+n
@ $E809 label=ACTOR_PTR
c $E809 HL = actor record of current actor ($E8A2)
@ $E81C label=NEG_A
c $E81C A = -A
b $E828
@ $E866 label=PROJECTILES
b $E866 3 thrown weapons; flags at $E888
@ $E8AB label=DRAW_ACTORS
c $E8AB Per-tick render: DRAW_FIELD, actor frame setup, masked blit, projectiles, copy to screen, clear rects
@ $E8DB label=ACTOR_FRAMES
c $E8DB For 6 actors: frame pointers from $DA0C, screen/buffer addresses from row table $D717
@ $E959 label=BLIT_ACTORS
c $E959 Masked sprite blit (AND mask, OR sprite) into back buffer, actors from $E4AC backwards
@ $E9B1 label=COPY_ACTORS_TO_SCREEN
c $E9B1 Copy each actor rectangle 7 bytes x 60 (66) rows from back buffer to screen with LDI
@ $EA0B label=CLEAR_ACTOR_RECTS
c $EA0B Zero actor rectangles 7 x 60 in back buffer (redrawn by DRAW_FIELD next tick)
@ $EA43 label=COPY_DOWNED_TO_SCREEN
c $EA43 Fighter in state $FF (down): copy 64 rows from back buffer at row $4880
@ $EA76 label=SCORE_TICK
c $EA76 Move 2 points from PENDING_POINTS to SCORE_DIGITS; if none pending skip the caller's next CALL (UPDATE_HUD)
@ $EAA7 label=UPDATE_HUD
c $EAA7 Print idol count and HUD strings
@ $EABC label=ROOM_BUILD
c $EABC Build room ROOM: tile $A0 (blank in room 1, else copy of $9C), stream, recolour, floor, holes, idol, walls; copy screen to back buffer
@ $EB50 label=RECOLOUR_ROWS
b $EB50 RECOLOUR_ROOM: rows (6), attribute pointers at $EB5C, room list at $EB56
@ $EB68 label=RECOLOUR_ROOM
c $EB68 Rooms in list $EB56: attributes $68-$6F in N rows -> paper blue (table index = 5 - list position)
@ $EB95 label=TILE_COLUMN
c $EB95 Advance tile column counter $E4CA (0..39) (?)
@ $EBE9 label=GAME_START
c $EBE9 Game entry: DI, seed RNG from R, menu, new game setup
b $EC2C
c $EC2D
@ $ED23 label=MAIN_LOOP
c $ED23 Main game loop: no HALT, runs unthrottled (~4.6 frames per pass in trace)
@ $EDA5 label=PAUSE
c $EDA5 Pause (key G) until a control is pressed
@ $EDC2 label=ENEMY_AI
c $EDC2 AI for actors 0..4 at $E461 (IY), writes their input bytes (?)
@ $EE29 label=HERO_DEATH
c $EE29 Hero down: count $EE8F (5 passes), wait until PENDING_POINTS drained, then GAME OVER (one life)
@ $EE4B label=HIT_HANDLER
c $EE4B Fighter $E8AA hit: sound, energy (+$0C) -= random 3..10; at 0 set KO flag $EE8C
b $EE8C
@ $EE91 label=KO_HANDLER
c $EE91 Fighter knocked out: points to PENDING_POINTS, mark record; hero -> HERO_KO ($EF24)
b $EEE5
c $EEE6
b $EF02
c $EF1C
@ $EF24 label=HERO_KO
c $EF24 Hero knocked out: last redraw, start HERO_DEATH (EE8E/EE8F)
@ $EF3F label=CHECK_HITS
c $EF3F Attack hit tests: enemies vs hero, hero vs enemies; sets $E8A9 (hit) / $E8AA (who)
@ $EF4E label=ENEMY_HITS_LOOP
c $EF4E Enemies 5..1 vs hero. ORIGINAL BUG: gate reads field +7 ($E4B3 = record 5 +7, high byte of the frame pointer, never 0) instead of +8 (state) like HERO_HITS_LOOP, so enemy melee never lands. ZX conversion slip: the CPC code tests one state array $7454+n in both loops. Fix: $EF4F $B3 -> $B4
@ $EFD7 label=HERO_HITS_LOOP
c $EFD7 Hero vs enemies 1..5: enemy state +8 = 0, hero input is an attack (table $FECA), reach (table $FEF6) overlaps
@ $F063 label=OVERLAP_TEST
c $F063 Range overlap test (H,L vs D,E); carry = no overlap
@ $F06C label=SOUND_HIT
c $F06C Beeper effect, OUT ($FE) at $F088
@ $F091 label=WINNER
c $F091 Seven idols in room 4: print WINNER, wait, restart
@ $F0A6 label=MSG_WINNER_FULL
b $F0A6 WINNER screen text
@ $F0AB label=MSG_WINNER
b $F0AB Message text
@ $F0D1 label=MSG_GAME_OVER
b $F0D1 Message text
@ $F0F2 label=ACTOR_RECORD
c $F0F2 HL = ACTORS + 15*A
@ $F0FD label=ACTOR_LOOP_SETUP
c $F0FD IY = $E470, B = 5, DE = 15
@ $F107 label=DRAW_WALLS
c $F107 No exit left/right (NEIGHBOURS) -> 4x15 wall block from $8134 / $8158
@ $F131 label=DRAW_TILE_BLOCK
c $F131 15 rows x 4 tiles from a 40-wide source at HL to map DE / screen BC
b $F185
@ $F1B4 label=PROJECTILES_MOVE
c $F1B4 3 thrown weapons at $E866 (IY) (?)
@ $F21B label=PROJECTILES_UPDATE
c $F21B 3 thrown weapons at $E866 (?)
@ $F277 label=PROJECTILES_HIT
c $F277 Thrown weapons vs actors, calls PROJECTILE_COLLIDE (?)
@ $F2BC label=PROJECTILES_VS_ACTORS
c $F2BC Loop over fighters 5..1 against thrown weapons
b $F3A2
@ $F3A7 label=PROJECTILE_SUB
c $F3A7 Helper of PROJECTILE_COLLIDE (?)
@ $F3C3 label=PROJECTILE_COLLIDE
c $F3C3 One thrown weapon vs actors (?)
b $F4AA
@ $F4AC label=ENEMY_STATE
c $F4AC For actors 5..1: state by record byte (?)
b $F550
@ $F554 label=IDOL_IN_ROOM
c $F554 Idol handling by control type $E1F3 via TABLE_WORD (?)
b $F5B2
c $F5BF
@ $F5CB label=CLEAR_HUD_ATTRS
c $F5CB Set attributes of the bottom HUD lines $5AA0..
b $F5EC
c $F5F2
b $F610
@ $F61C label=ENEMY_NAMES
b $F61C 4 pointers: THUG, KARATEKA, NINJA, HERO
@ $F62F label=DRAW_ROOM_TOP
c $F62F Room stream -> 480 cells (rows 0-14); column counter 0..39, columns 4..35 visible
@ $F64C label=DRAW_ROOM_STREAM
c $F64C Draw room from tile stream at ($E4C4), $FF = end (?)
b $F694
@ $F699 label=ENTER_ROOM
c $F699 Go to the neighbour of ROOM in direction A (0 left, 1 right, 2 up, 3 down) and set it up; new game: ROOM=6, A=1 -> room 4
@ $F800 label=TILE25_COLOUR
c $F800 Tile $25 attribute: $2C in rooms listed at $F694 (4,6,8,3,5), else $2A
@ $F817 label=RAINBOW
c $F817 Room 0: rows 4-10 get paper 1..7
b $F897
c $F8AE
b $F8B2
c $F8B4
@ $F908 label=ROOM_SOUND
c $F908 Beeper loop through ROM BEEPER (bug 1: BEEPER ends with EI)
b $F91B
c $F91D
b $F921
@ $F925 label=ROOM_TRANSITION
c $F925 Room change effect, 50 steps drawing from $DA0C tables onto map $8AB6
b $F96F
c $F97E
b $FA27
c $FA37
b $FA85
c $FA8F
@ $FAF3 label=IDOL_ROOM_CHECK
c $FAF3 Carry if current room+1 is in IDOL_ROOMS
b $FB06
@ $FB0A label=IDOL_GFX
b $FB0A Idol 2 bytes x 16 rows
@ $FB2A label=NEXT_ROOM
c $FB2A ROOM = NEIGHBOURS[ROOM][A]-1 (NC if no exit), clear screen, APPROACHING <name>
b $FB6F
@ $FB71 label=ANIMATE_ALL
c $FB71 For 6 actors (IY=$E4AC backwards) (?)
@ $FC41 label=HERO_SUB
c $FC41 Called when $E8A5 != 0 (?)
@ $FC64 label=RESET_INPUTS
c $FC64 Clear per-actor input bytes except $14
@ $FC78 label=HERO_ACTION
c $FC78 Hero action by HERO_INPUT ($0D = special) (?)
@ $FC86 label=HERO_PICKUP
c $FC86 Hero input $0D: pick up / use item by $E4CD (?)
@ $FD00 label=ROOM_EXITS
c $FD00 Hero X<2 -> ENTER_ROOM(0) left, X>=$19 -> ENTER_ROOM(1) right
b $FD0F
c $FD16
b $FD2C
c $FD31
@ $FD3D label=HOLE_EXITS
c $FD3D Up under HOLE_CEIL (X..X+2): climb, ENTER_ROOM(2); down+crouch phase 2 over HOLE_FLOOR: ENTER_ROOM(3)
@ $FDDC label=SETUP_HOLES
c $FDDC HOLE_CEIL/HOLE_FLOOR from HOLES table for ROOM; draw them on screen
@ $FE0F label=DRAW_HOLE_SCREEN
c $FE0F Draw a hole on screen: 3 bytes x 16 rows of $FF, edges from ($FE25)
@ $FE56 label=DRAW_HOLES
c $FE56 Per tick: floor hole (HOLE_FLOOR) into back buffer at $6B60+X, then ceiling hole (HOLE_CEIL)
@ $FE83 label=DRAW_CEILING_HOLE
c $FE83 Ceiling hole into back buffer at $5B00+X: 3 bytes x 16 rows of $FF, edges from $DBFF
b $FECA
@ $FF48 label=DOOR_COLOUR
c $FF48 Rooms 19/20: 8x8 door attributes at row 5 col 12 ($50 red / $60 green)
b $FF62
i $FF80
